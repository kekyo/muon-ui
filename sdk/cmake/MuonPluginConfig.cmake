# Relocatable package: consumers supply MUON_PLUGIN_TARGET and, when cross
# compiling, a target pkg-config environment from `muon-plugin env`.
if(NOT DEFINED MUON_PLUGIN_TARGET)
  set(MUON_PLUGIN_TARGET "$ENV{MUON_TARGET}")
endif()
get_filename_component(_muon_sdk "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_muon_pc "${_muon_sdk}/native/${MUON_PLUGIN_TARGET}/lib/pkgconfig")
if(NOT EXISTS "${_muon_pc}/muon-plugin.pc")
  message(FATAL_ERROR "muon-plugin-sdk has no ${MUON_PLUGIN_TARGET} link inputs. Run muon-plugin doctor --target ${MUON_PLUGIN_TARGET}.")
endif()
set(ENV{PKG_CONFIG_PATH} "${_muon_pc}")
find_package(PkgConfig REQUIRED)
if(NOT TARGET Muon::Plugin)
  pkg_check_modules(MUON_PLUGIN REQUIRED IMPORTED_TARGET muon-plugin)
  add_library(Muon::Plugin INTERFACE IMPORTED)
  set_property(TARGET Muon::Plugin PROPERTY INTERFACE_LINK_LIBRARIES PkgConfig::MUON_PLUGIN)
endif()
foreach(_muon_component IN LISTS MuonPlugin_FIND_COMPONENTS)
  if(NOT _muon_component STREQUAL "Cardio")
    message(FATAL_ERROR "Unknown MuonPlugin component: ${_muon_component}")
  endif()
  if(NOT TARGET Muon::Cardio)
    pkg_check_modules(MUON_PLUGIN_CARDIO REQUIRED IMPORTED_TARGET muon-plugin-cardio)
    add_library(Muon::Cardio INTERFACE IMPORTED)
    set_property(TARGET Muon::Cardio PROPERTY INTERFACE_LINK_LIBRARIES PkgConfig::MUON_PLUGIN_CARDIO)
    set_property(TARGET Muon::Cardio PROPERTY INTERFACE_COMPILE_FEATURES cxx_std_20)
  endif()
endforeach()
