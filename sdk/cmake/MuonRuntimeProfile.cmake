# Core builds and external SDK consumers use the same cardio ABI definitions.
include_guard(GLOBAL)
function(muon_runtime_cardio_definitions platform result)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/runtime-profile.json" profile)
  string(JSON expected GET "${profile}" cardioHeaderSha256)
  file(SHA256 "${CARDIO_ROOT_RESOLVED}/include/cardio.h" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "The cardio checkout differs from the SDK runtime profile. Update sdk/src/runtime-profile.json when updating the shared runtime.")
  endif()
  string(JSON count LENGTH "${profile}" cardioDefinitions ${platform})
  math(EXPR last "${count} - 1")
  set(definitions)
  foreach(index RANGE 0 ${last})
    string(JSON definition GET "${profile}" cardioDefinitions ${platform} ${index})
    list(APPEND definitions "${definition}")
  endforeach()
  set(${result} "${definitions}" PARENT_SCOPE)
endfunction()
