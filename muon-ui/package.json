{
  "name": "muon-ui",
  "version": "0.0.1",
  "type": "module",
  "types": "./muon.d.ts",
  "bin": {
    "muon": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./muon.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./muon.d.ts": "./muon.d.ts"
  },
  "files": [
    "dist",
    "muon.d.ts",
    "vite.d.ts"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build --workspace muon-prepare && node scripts/stage-muon-prepare.mjs",
    "build:js": "vite build --mode cjs && vite build --mode esm",
    "build:dist": "bash ../build_package.sh --target dist",
    "test": "npm run build && vitest run",
    "test:windows-nsis-e2e": "npm run build && MUON_E2E_REMOTE_WINDOWS=1 vitest run test/nsis-windows-e2e.test.ts",
    "verify:package-runtime": "node scripts/verify-package-runtime.mjs",
    "pack": "bash ../build_package.sh",
    "dependencies": "reskill"
  },
  "dependencies": {
    "adm-zip": ">=0.5.0",
    "commander": ">=14.0.0",
    "json5": ">=2.2.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/adm-zip": ">=0.5.8",
    "@types/node": ">=24.0.0",
    "agent-rover": "^0.1.0",
    "async-primitives": ">=1.7.0",
    "prettier-max": ">=1.16.0",
    "screw-up": ">=1.34.0",
    "typescript": ">=5.9.0",
    "vite": ">=7.0.0",
    "vitest": ">=2.0.0"
  }
}
