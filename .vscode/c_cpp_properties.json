{
  "version": 4,
  "configurations": [
    {
      "name": "Linux",
      "compilerPath": "/usr/bin/g++",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-gcc-x64",
      "includePath": [
        "${workspaceFolder}/muon-core/include",
        "${workspaceFolder}/muon-core/src",
        "${workspaceFolder}/muon-core/.cef/cef_binary_*_linux64_minimal",
        "${workspaceFolder}/muon-core/.deps/src/yyjson-0.12.0/src",
        "${workspaceFolder}/muon-core/tests",
        "${workspaceFolder}/muon-core/test_plugins",
        "${workspaceFolder}/deps/tra-ffic/include",
        "${workspaceFolder}/deps/cardio/include",
        "/usr/include/glib-2.0",
        "/usr/lib/x86_64-linux-gnu/glib-2.0/include",
        "/usr/include/gio-unix-2.0",
        "/usr/include/libmount",
        "/usr/include/blkid"
      ],
      "defines": [
        "__STDC_CONSTANT_MACROS",
        "__STDC_FORMAT_MACROS",
        "_FILE_OFFSET_BITS=64",
        "MUON_HAS_LIBURING=1",
        "CARDIO_WITH_GLIB=1",
        "CARDIO_WITH_GIO=1"
      ]
    }
  ]
}
