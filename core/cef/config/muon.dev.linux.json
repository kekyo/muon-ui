{
  "network": {
    "allow": [
      "asset://main/**"
    ]
  },
  "plugin": {
    "mode": "simple",
    "path": "./plugins",
    "pages": [
      "asset://main/**",
      "data:**"
    ],
    "plugins": [
      {
        "name": "internal",
        "allow": [
          "muon.**"
        ]
      }
    ]
  },
  "cdp": {
    "enable": true,
    "port": 9222
  },
  "browser": {
    "initialWindowState": "normal",
    "titleBarType": "muon",
    "keybind": {
      "devtools": "f12",
      "recycle": "ctrl+f12"
    }
  }
}
