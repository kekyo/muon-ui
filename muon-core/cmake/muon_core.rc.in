#include <windows.h>

1 VERSIONINFO
FILEVERSION @MUON_WINDOWS_VERSION_COMMA@
PRODUCTVERSION @MUON_WINDOWS_VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x28L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "@MUON_WINDOWS_COMPANY_NAME@\0"
      VALUE "FileDescription", "Muon Core Runtime\0"
      VALUE "FileVersion", "@MUON_WINDOWS_STRING_VERSION@\0"
      VALUE "InternalName", "muon-core\0"
      VALUE "LegalCopyright", "@MUON_WINDOWS_LEGAL_COPYRIGHT@\0"
      VALUE "OriginalFilename", "muon-core.exe\0"
      VALUE "ProductName", "Muon\0"
      VALUE "ProductVersion", "@MUON_WINDOWS_STRING_VERSION@\0"
      VALUE "Comments", "@MUON_WINDOWS_COMMENTS@\0"
      VALUE "PrivateBuild", "@MUON_WINDOWS_GIT_COMMIT_HASH@\0"
      VALUE "SpecialBuild", "@MUON_WINDOWS_SPECIAL_BUILD@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
