{
  "name": "muon-ui",
  "version": "0.0.1",
  "type": "module",
  "types": "./muon.d.ts",
  "bin": {
    "muon": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./muon.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./muon.d.ts": "./muon.d.ts",
    "./muon-virtual-modules.d.ts": "./muon-virtual-modules.d.ts"
  },
  "files": [
    "dist",
    "muon.d.ts",
    "muon-virtual-modules.d.ts",
    "vite.d.ts",
    "android.d.ts"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build --workspace muon-builder && node scripts/stage-muon-builder.mjs && npm run build --workspace muon-android && node scripts/stage-android-runtime.mjs dist/android",
    "build:js": "vite build --mode cjs && vite build --mode esm && vite build --mode android-host",
    "build:linux-dependencies": "vite build --mode linux-dependencies",
    "build:dist": "bash ../build_package.sh --target dist",
    "test": "npm run build && vitest run",
    "test:windows-nsis-e2e": "npm run build && vitest run cef-test/nsis-windows-e2e.test.ts",
    "test:android-system-bars-e2e": "MUON_ANDROID_SYSTEM_BARS_E2E=1 vitest run android-test/system-bars-e2e.test.ts",
    "test:android-settings-e2e": "MUON_ANDROID_SETTINGS_E2E=1 vitest run android-test/settings-e2e.test.ts",
    "test:android-notifications-e2e": "MUON_ANDROID_NOTIFICATIONS_E2E=1 vitest run android-test/notifications-e2e.test.ts",
    "verify:package-runtime": "node scripts/verify-package-runtime.mjs",
    "pack": "bash ../build_package.sh",
    "dependencies": "reskill"
  },
  "dependencies": {
    "adm-zip": ">=0.5.0",
    "commander": ">=14.0.0",
    "funcity": "^1.5.0",
    "json5": ">=2.2.0",
    "semver": ">=7.8.5",
    "sharp": "^0.35.2",
    "tar-vern": ">=1.3.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/mcp": "^0.0.83",
    "@types/adm-zip": ">=0.5.8",
    "@types/node": ">=24.0.0",
    "@types/semver": ">=7.7.0",
    "agent-rover": "^0.10.0",
    "async-primitives": ">=1.7.0",
    "muon-plugin-sdk": "0.0.1",
    "prettier-max": ">=1.16.0",
    "screw-up": ">=1.35.0",
    "typescript": ">=5.9.0",
    "vite": ">=7.0.0",
    "vitest": ">=2.0.0"
  }
}
